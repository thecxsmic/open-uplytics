# App origin. The tracking snippet uses this host.
APP_URL=http://localhost:3000

# Signs the session cookie. Use a long random string.
AUTH_SECRET=

# Optional Google sign-in. Redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# One Postgres database for accounts, sites, ingest, and aggregates.
DATABASE_URL=postgresql://uplytics:uplytics@localhost:5432/uplytics

# Cron shared secret (Authorization: Bearer ... or X-Cron-Secret)
CRON_SECRET=replace-with-cron-secret
# Set to 0 to disable the built-in scheduler and use an outside caller only.
# On Vercel the built-in scheduler never starts. See docs/cron.md.
# CRON_INTERNAL=0

# Optional mail for uptime alerts and password reset (Resend)
RESEND_API_KEY=
RESEND_FROM=Uplitycs <noreply@localhost>

# Set to 1 to skip Origin/Referer checks while developing
COLLECT_SKIP_ORIGIN=0

# Demo workspace: npm run db:demo, then open /demo
# DEMO_SITE_ID=uplyticsweb1
# DEMO_TRACK=0
